# Octupie Video Editor environment. Copy to .env and fill in.
# NEVER commit a real .env. All values below are placeholders only.

# Optional override for the FFmpeg binary. Defaults to `ffmpeg` on PATH.
OVE_FFMPEG_PATH=

# Optional override for the FFprobe binary. Defaults to `ffprobe` on PATH.
OVE_FFPROBE_PATH=

# Root directory for all source clips, stills, dialogue, music, and SFX.
# Defaults to `assets` under the current project. Plan paths stay relative to it.
OVE_ASSET_ROOT=assets

# Directory the CLI writes renders, QA reports and demo output into.
# Relative to the project root. Gitignored.
OVE_OUTPUT_DIR=output

# Remotion render concurrency. Leave blank for the Remotion default.
OVE_RENDER_CONCURRENCY=

# Rights-safe SFX manifest downloader. Placeholder base URL only.
# The downloader refuses to run without an explicit, license-checked source.
OVE_SFX_MANIFEST_URL=

# --- Agentic layer ---

# Where the agent stores append-only run records and human feedback rules.
# Defaults OUTSIDE this repo, at ~/.octupie-video-editor. Never point this at a
# private credential directory.
OVE_AGENT_HOME=

# Optional override for the standalone Claude CLI binary. Defaults to `claude`
# on PATH. The agent uses the existing CLI login or standard API env vars; it
# never reads another tool's private auth files.
OVE_CLAUDE_BIN=

# Optional override for the standalone Codex CLI binary. Defaults to `codex`
# on PATH.
OVE_CODEX_BIN=

# --- Local product server (npm run dev / npm run worker) ---

# Host and port for the product server. Defaults 127.0.0.1:8722.
OVE_SERVER_HOST=
OVE_SERVER_PORT=

# SQLite path shared by the server and the worker. Use a file path (NOT :memory:)
# so the two processes cooperate. Defaults to an in-memory database.
OVE_SERVER_DB=

# Local content-addressed storage root and streaming-upload temp directory.
OVE_SERVER_STORAGE=
OVE_SERVER_TEMP=

# Static browser app directory. Defaults to the packaged public/ next to the CLI.
OVE_SERVER_PUBLIC=

# Users as a JSON array. Tokens are read ONLY from here, never from the database.
# Shape: [{"id","tenantId","username","role","token"}]. Roles: viewer, editor,
# approver, publisher, admin. Tokens must be at least 16 chars and unique.
OVE_SERVER_USERS=

# Permission grants as a JSON array, default-deny. Shape:
# [{"action","grantedBy","grantedAt","expiresAt?","reason?"}]. Actions: network,
# media-upload, publishing, code-change. Without a grant the action is refused.
OVE_SERVER_GRANTS=

# Max single upload size in bytes. Defaults to 500 MiB.
OVE_SERVER_MAX_UPLOAD=

# Per-tenant durable storage quota in bytes (uploads + generated + materialized).
# Enforced before a media row is registered. Defaults to 2 GiB per tenant.
OVE_SERVER_MAX_TENANT_BYTES=

# --- Optional Google Drive materialization ---
# NAME of the env var holding a Drive OAuth token (read at call time only).
OVE_DRIVE_TOKEN_ENV=
# The token value itself, if you use the default name above.
OVE_DRIVE_TOKEN=

# --- Optional HTTPS webhook publishing (off by default) ---
# Endpoint URL, comma-separated host allowlist, and the NAME of the env var
# holding the webhook secret. All three plus a publishing grant are required.
OVE_WEBHOOK_URL=
OVE_WEBHOOK_HOSTS=
OVE_WEBHOOK_SECRET_ENV=
OVE_WEBHOOK_SECRET=
