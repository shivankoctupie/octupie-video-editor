# Octupie Video Editor environment. Copy to .env and fill in.
# NEVER commit a real .env. All values below are placeholders only.

# Optional override for the FFmpeg binary. Defaults to `ffmpeg` on PATH.
OVE_FFMPEG_PATH=

# Optional override for the FFprobe binary. Defaults to `ffprobe` on PATH.
OVE_FFPROBE_PATH=

# Root directory for all source clips, stills, dialogue, music, and SFX.
# Defaults to `assets` under the current project. Plan paths stay relative to it.
OVE_ASSET_ROOT=assets

# Directory the CLI writes renders, QA reports and demo output into.
# Relative to the project root. Gitignored.
OVE_OUTPUT_DIR=output

# Remotion render concurrency. Leave blank for the Remotion default.
OVE_RENDER_CONCURRENCY=

# Rights-safe SFX manifest downloader. Placeholder base URL only.
# The downloader refuses to run without an explicit, license-checked source.
OVE_SFX_MANIFEST_URL=
